diff --git a/node_modules/pg/lib/query.js b/node_modules/pg/lib/query.js
index 6655a0e..499b89d 100644
--- a/node_modules/pg/lib/query.js
+++ b/node_modules/pg/lib/query.js
@@ -216,7 +216,11 @@ class Query extends EventEmitter {
         valueMapper: utils.prepareValue,
       })
     } catch (err) {
-      this.handleError(err, connection)
+      // Send Sync so the server leaves the extended query and ReadyForQuery
+      // arrives; otherwise a throw during bind leaves the connection hung.
+      // Defer the error until ReadyForQuery so a callback is not called twice.
+      connection.sync()
+      this._canceledDueToError = err
       return
     }
 
